{
  "name": "monalauncher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin --deny-warnings .",
    "lint:fix": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
