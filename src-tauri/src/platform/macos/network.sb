; Explicit TCP/UDP grant, including listeners and local networks. No blanket Unix sockets.
(allow network-outbound (remote tcp) (remote udp)
    (literal "/private/var/run/mDNSResponder"))
(allow network-bind network-inbound (local tcp) (local udp))
(allow file-read* (literal "/private/etc/hosts")
    (literal "/private/etc/resolv.conf") (literal "/private/var/run/resolv.conf"))
(allow mach-lookup
    (global-name "com.apple.SystemConfiguration.DNSConfiguration")
    (global-name "com.apple.SystemConfiguration.configd"))
